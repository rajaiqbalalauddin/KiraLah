<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Window theme only. All real styling lives in Compose (ui/theme). The lavender window
         background avoids a white flash before the first frame draws. -->
    <style name="Theme.Buyless" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/lavender</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
</resources>
